# Your receiver location (from Google Maps — right-click → "Copy coordinates")
LAT=your_latitude_here
LON=your_longitude_here

# Search radius in kilometres
RADIUS_KM=50

# Local ADS-B data source — use a URL or a file path depending on your setup:
#   dump1090-mutability (writes JSON files):
#ADSB_URL=/run/dump1090-mutability/aircraft.json
#   dump1090-fa / dump1090 with HTTP server:
#ADSB_URL=http://localhost:8080/data/aircraft.json
#   fr24feed built-in dump1090:
#ADSB_URL=http://localhost:8754/data/aircraft.json
ADSB_URL=/run/dump1090-mutability/aircraft.json

# Seconds between display updates (minimum 15 recommended)
REFRESH_RATE=30
